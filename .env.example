# Rename this file to .env and fill in your values

# Gmail SMTP — use an App Password (not your main password)
# Steps: Google Account → Security → 2-Step Verification → App Passwords → Generate
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_TO=achraf-berrihi@hotmail.com

# Server port
PORT=3000

# Optional: allow cross-origin calls to /api from this origin (same-origin needs nothing)
SITE_URL=https://synthique.ai

# Set to 1 when running behind a reverse proxy / PaaS (Render, Railway, Nginx)
TRUST_PROXY=1
